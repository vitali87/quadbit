 146     data_parallel_external_lb: bool = False
 147     """Whether to use "external" DP LB mode. Applies only to online serving
 148     and when data_parallel_size > 0. This is useful for a "one-pod-per-rank"
 149     wide-EP setup in Kubernetes. Supported only for MoE deployments; non-MoE
 150     models should use independent vLLM instances without --data-parallel-*
 151     arguments. Set implicitly when --data-parallel-rank is provided explicitly
 152     to vllm serve."""
 153     data_parallel_hybrid_lb: bool = False
 154     """Whether to use "hybrid" DP LB mode. Applies only to online serving
 155     and when data_parallel_size > 0. Enables running an AsyncLLM
 156     and API server on a "per-node" basis where vLLM load balances
 157     between local data parallel ranks, but an external LB balances
 158     between vLLM nodes/replicas. Set explicitly in conjunction with
 159     --data-parallel-start-rank."""
 160     is_moe_model: bool | None = None
 161     """Whether the deployed model is MoE (if known)."""
 162     enable_expert_parallel: bool = False
 163     """Use expert parallelism instead of tensor parallelism for MoE layers."""
 164     enable_ep_weight_filter: bool = False
 165     """Skip non-local expert weights during model loading when expert
 166     parallelism is active.  Each rank only reads its own expert shard from
 167     disk, which can drastically reduce storage I/O for MoE models with
 168     per-expert weight tensors (e.g. DeepSeek, Mixtral, Kimi-K2.5).  Has no
 169     effect on 3D fused-expert checkpoints (e.g. GPT-OSS) or non-MoE
 170     models."""
 171     enable_eplb: bool = False
 172     """Enable expert parallelism load balancing for MoE layers."""
 173     eplb_config: EPLBConfig = Field(default_factory=EPLBConfig)
