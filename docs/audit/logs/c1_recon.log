 792     def create_weights(
 793         self,
 794         layer: RoutedExperts,
 795         num_experts: int,
 796         hidden_size: int,
 797         intermediate_size_per_partition: int,
 798         params_dtype: torch.dtype,
 799         **extra_weight_attrs,
 800     ):
 801         layer.orig_dtype = params_dtype
 802         layer.num_experts = num_experts
 803 
 804         # Use FP8 dtype if checkpoint is serialized
 805         weight_dtype = (
 806             torch.float8_e4m3fn
 807             if self.quant_config.is_checkpoint_fp8_serialized
 808             else params_dtype
 809         )
 810         weight_loader = extra_weight_attrs.get("weight_loader")
 811 
 812         w13_num_shards = 2 if self.moe.is_act_and_mul else 1
 813 
 814         w13_weight = ModelWeightParameter(
 815             data=torch.empty(
 816                 num_experts,
 817                 w13_num_shards * intermediate_size_per_partition,
 818                 hidden_size,
 819                 dtype=weight_dtype,
 820             ),
 821             input_dim=2,
 822             output_dim=1,
 823             weight_loader=weight_loader,
 824         )
 825         layer.register_parameter("w13_weight", w13_weight)
 826 
 827         w2_weight = ModelWeightParameter(
 828             data=torch.empty(
 829                 num_experts,
 830                 hidden_size,
 831                 intermediate_size_per_partition,
 832                 dtype=weight_dtype,
 833             ),
 834             input_dim=2,
 835             output_dim=1,
 836             weight_loader=weight_loader,
 837         )
 838         layer.register_parameter("w2_weight", w2_weight)
 839 
 840         # WEIGHT SCALES - Per-tensor scaling for ModelOpts
 841         # For gated MoE, allocate 2 scales for w1 and w3 respectively.
 842         # They will be combined to a single scale after weight loading.
 843         # For non-gated MoE, allocate 1 scale for w13.
 844         w13_weight_scale = PerTensorScaleParameter(
 845             data=torch.full(
 846                 (num_experts, w13_num_shards),
 847                 1.0,
 848                 dtype=torch.float32,
 849             ),
 850             weight_loader=weight_loader,
 851         )
