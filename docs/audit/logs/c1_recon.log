 721     def process_weights_after_loading(self, layer: torch.nn.Module) -> None:
 722         # Keep weight in [out, in] layout for Fp8BlockScaledMMLinearKernel.
 723         layer.weight = Parameter(layer.weight.data, requires_grad=False)
 724 
 725         scale = layer.weight_scale
 726         if scale.dim() == 4:
 727             # [out_blk, 1, in_blk, 1] -> [out_blk, in_blk]
 728             scale = scale.squeeze(1).squeeze(-1)
 729         elif scale.dim() != 2:
 730             raise ValueError(
 731                 "Unexpected ModelOpt FP8_PB_WO weight_scale shape: "
 732                 f"{tuple(scale.shape)}."
 733             )
 734 
 735         layer.weight_scale = Parameter(scale.contiguous(), requires_grad=False)
 736 
 737         if hasattr(self, "fp8_linear"):
 738             self.fp8_linear.process_weights_after_loading(layer)
 739 
