 518     def process_weights_after_loading(self, layer: torch.nn.Module) -> None:
 519         weight = layer.weight
 520         max_w_scale = layer.weight_scale.max()
 521         if not (layer.weight_scale == layer.weight_scale[0]).all():
 522             max_w_scale, weight = requantize_with_max_scale(
 523                 layer.weight, layer.weight_scale, layer.logical_widths
 524             )
 525         layer.weight = Parameter(weight.t(), requires_grad=False)
 526         layer.weight_scale = Parameter(max_w_scale, requires_grad=False)
 527         layer.input_scale = Parameter(layer.input_scale.max(), requires_grad=False)
 528         self.fp8_linear.process_weights_after_loading(layer)
 529 
