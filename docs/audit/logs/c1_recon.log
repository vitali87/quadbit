 223     def apply_vllm_mapper(self, hf_to_vllm_mapper: "WeightsMapper"):
 224         if len(self.exclude_modules) > 0:
 225             # This is a workaround for the weights remapping issue:
 226             # https://github.com/vllm-project/vllm/issues/28072
 227             # Right now, the Nvidia ModelOpt library use just one wildcard pattern:
 228             #        module_path*
 229             # It gets applied if the whole tree of modules rooted at module_path
 230             # is not quantized. Here we replace such pattern by 2 patterns that are
 231             # collectively equivalent to the original pattern:
 232             #        module_path
 233             #        module_path.*
 234             new_exclude_modules = []
 235             for exclude in self.exclude_modules:
 236                 if len(exclude) >= 2 and exclude[-1] == "*" and exclude[-2] != ".":
 237                     new_exclude_modules.append(exclude[:-1])
 238                     new_exclude_modules.append(exclude[:-1] + ".*")
 239                 else:
 240                     new_exclude_modules.append(exclude)
 241 
 242             self.exclude_modules = hf_to_vllm_mapper.apply_list(new_exclude_modules)
 243 
 244     @staticmethod
 245     def _extract_modelopt_quant_algo(
 246         hf_quant_cfg: dict[str, Any] | None,
 247     ) -> str | None:
 248         """Extract upper-cased quant_algo from a modelopt config.
 249 
 250         Returns the quant_algo string (upper-cased), or None if the config
 251         is not a modelopt config.
 252         """
 253         if hf_quant_cfg is None:
 254             return None
 255         if not hf_quant_cfg.get("quant_method", "").lower().startswith("modelopt"):
 256             return None
 257         if "quantization" in hf_quant_cfg:
 258             quant_config = hf_quant_cfg["quantization"]
 259             if isinstance(quant_config, dict):
 260                 return str(quant_config.get("quant_algo", "")).upper()
 261             return None
 262         return str(hf_quant_cfg.get("quant_algo", "")).upper()
